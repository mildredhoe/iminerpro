# Variables de entorno de MinerPro
# Copia este archivo a `.env` (en la raíz del proyecto o en ~/.minerpro/.env)
# y rellena los valores. También puedes usar `minerpro cloud connect <plataforma>`
# para guardarlos en el llavero del sistema (recomendado).

# --- NiceHash (https://www.nicehash.com/my/settings/keys) ---------------------
# Permisos: Mining (lectura) + Wallet (lectura). NUNCA habilites retiros.
MINERPRO_NICEHASH_KEY=
MINERPRO_NICEHASH_SECRET=
MINERPRO_NICEHASH_ORG=

# --- Binance Pool / Cloud Mining --------------------------------------------
# https://www.binance.com/en/my/settings/api-management
# Permisos: "Enable Reading" y restricción de IP. NUNCA habilites retiros.
MINERPRO_BINANCE_KEY=
MINERPRO_BINANCE_SECRET=

# --- Overrides opcionales ----------------------------------------------------
# Usar un binario de XMRig ya instalado en vez de descargarlo:
# MINERPRO_XMRIG_PATH=/usr/local/bin/xmrig
# Cambiar la carpeta de datos de MinerPro (default: ~/.minerpro):
# MINERPRO_HOME=/ruta/a/datos
